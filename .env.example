# Copy to .env and fill in. .env is gitignored: never commit it.
# This file is parsed by the bot itself, NOT loaded into the process environment, so the Claude Code and
# Codex child processes never see your bot token. Do not load it with systemd's EnvironmentFile= or
# `export` it, or that protection is lost.
# Any AGENT_* variable set in the real environment overrides the value here.
# Paths: `~/` means your home directory, and a relative path starts from this repository.

# ---- Required ---------------------------------------------------------------------------------------

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
DISCORD_TOKEN=
# Application ID (General Information -> Application ID).
DISCORD_CLIENT_ID=
# Owners: comma-separated Discord user ids. Only these people can give the agent instructions, approve
# its actions, and change models. Owners get a real shell on this machine: list only people you trust
# with it. (Discord: Settings -> Advanced -> Developer Mode, then right-click a user -> Copy User ID.)
AGENT_ALLOWED_USERS=

# ---- Guests (optional): sandboxed users ---------------------------------------------------------------

# Comma-separated Discord user ids that may use the bot without being owners. Their tasks run in a
# sandbox: no shell, no files, no memory, no Discord reading. Owners listed above always win.
AGENT_GUEST_USERS=
# Guests allowed to have Python run to make files (spreadsheets, documents, charts). It only ever runs
# in a throwaway Modal sandbox (modal/guest_files.py), never on this machine. Needs a Modal account.
AGENT_GUEST_FILES=
# Python that has the `modal` package installed and logged in (`pip install modal && modal setup`).
# AGENT_MODAL_PYTHON=python3
# Modal profile to use, if you have several.
# AGENT_MODAL_PROFILE=
# Each guest's own empty working directory. Keep it outside any repository.
# Default: <your home>/agent-guests.
# AGENT_GUEST_HOME=
# Notes added to guests' prompts only (what to help with, tone). See guest-instructions.example.md.
# Default: ./guest-instructions.md
# AGENT_GUEST_INSTRUCTIONS_FILE=

# ---- Where it listens (optional) ------------------------------------------------------------------------

# Channels where an owner's message needs no @mention (comma-separated channel ids). Other channels
# need a mention; DMs never do. Threads under an open channel do NOT inherit this.
AGENT_OPEN_CHANNELS=
# Servers where the bot keeps a low profile (comma-separated server ids): tasks run in private
# threads and leave no reactions or notes in the channels.
AGENT_UNDERCOVER_GUILDS=

# ---- The agent itself (optional) ------------------------------------------------------------------------

# How much owners' tasks may do without asking:
#   auto   (default) Claude's auto mode / Codex on-request approvals with a reviewer in a workspace-write
#          sandbox. Anything undecided comes to the owners as Approve / Deny buttons.
#   bypass no approvals and no sandbox: the agent can do anything the bot's user can. Only on a machine
#          you do not mind it fully controlling. Guest tasks are never affected.
# AGENT_PERMISSION_MODE=auto
# Where the agent starts working (default: your home directory).
# AGENT_CWD=
# Your own notes for the agent: what this machine is, what to be careful with. See instructions.example.md.
# Default: ./instructions.md
# AGENT_INSTRUCTIONS_FILE=
# Directory of notes shared between sessions that Codex is pointed at (Claude uses its own memory).
# AGENT_MEMORY_DIR=
# The engine new tasks start on: claude (default) or codex. /engine changes it later.
# AGENT_ENGINE=claude
# How to start Codex: a name on PATH, or the full path to the executable. On Windows it must be the native
# codex.exe (npm's codex.cmd shim cannot be used); see README, "Windows". Do not wrap a Windows path in double quotes.
# Default: codex
# AGENT_CODEX_BIN=
# First-run Claude model if ~/.claude/settings.json names none (alias or full id). /model changes it later.
# AGENT_MODEL=
# First-run Codex model if ~/.codex/config.toml names none. /model changes it later.
# Default: gpt-6-astra
# AGENT_CODEX_MODEL=
# Directories searched (5 levels deep) for .env files; every value found is redacted from anything the
# bot posts to Discord, on top of pattern matching. Default: your home directory plus this repository.
# AGENT_SECRET_SCAN_DIRS=
# Task records, settings and downloaded attachments (default: ./data).
# AGENT_DATA_DIR=
# Recent channel messages handed to the agent as context.
# AGENT_CONTEXT_MESSAGES=10
# Tasks running at once.
# AGENT_MAX_CONCURRENT=3
# Hard cap on one turn.
# AGENT_TURN_MAX_MINUTES=120
# An idle session closes after this long (it resumes on the next message).
# AGENT_IDLE_CLOSE_MINUTES=15
# An unanswered approval button times out after this long.
# AGENT_APPROVAL_MINUTES=30
# Name of the PM2 process, only used to tell the agent which process it runs in.
# AGENT_PM2_NAME=discord-agent

# ---- Voice messages (optional) ----------------------------------------------------------------------------

# Owners' voice messages and audio files can be transcribed before the agent sees them. Set either or both.
# An HTTP backend: POST <url>/transcribe?vad=1&prompt=... with the audio as the body and an optional
# "Authorization: Bearer <token>"; it answers {"text", "language", "duration"}. modal/transcribe.py is
# one ready-made backend (GPU whisper on Modal); anything with that contract works.
# TRANSCRIBE_URL=
# TRANSCRIBE_TOKEN=
# Names and terms the transcriber should spell correctly, comma-separated.
# TRANSCRIBE_VOCABULARY=
# Or transcribe on this machine: a Python with `faster-whisper` and numpy installed, and ffmpeg on PATH
# (see scripts/whisper_local.py). Used when TRANSCRIBE_URL is unset or fails.
# AGENT_WHISPER_PYTHON=
